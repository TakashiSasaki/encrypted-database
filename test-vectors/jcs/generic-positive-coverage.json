[
  {
    "name": "empty-string",
    "description": "Top-level empty string",
    "input": "",
    "expected_string": "\"\"",
    "expected_hex": "2222"
  },
  {
    "name": "object-empty-key",
    "description": "Object with empty string key",
    "input": { "": 1 },
    "expected_string": "{\"\":1}",
    "expected_hex": "7b22223a317d"
  },
  {
    "name": "nested-empty",
    "description": "Nested empty object and array",
    "input": { "a": {}, "b": [] },
    "expected_string": "{\"a\":{},\"b\":[]}",
    "expected_hex": "7b2261223a7b7d2c2262223a5b5d7d"
  },
  {
    "name": "mixed-array",
    "description": "Mixed array with all base types",
    "input": [null, true, false, "str", 42, {}, []],
    "expected_string": "[null,true,false,\"str\",42,{},[]]",
    "expected_hex": "5b6e756c6c2c747275652c66616c73652c22737472222c34322c7b7d2c5b5d5d"
  },
  {
    "name": "escaped-string",
    "description": "String requiring escapes",
    "input": "\"\\\b\f\n\r\t",
    "expected_string": "\"\\\"\\\\\\b\\f\\n\\r\\t\"",
    "expected_hex": "225c225c5c5c625c665c6e5c725c7422"
  },
  {
    "name": "solidus",
    "description": "Forward slash / should not be escaped",
    "input": "/",
    "expected_string": "\"/\"",
    "expected_hex": "222f22"
  },
  {
    "name": "non-ascii-bmp",
    "description": "Non-ASCII BMP character",
    "input": "äöü",
    "expected_string": "\"äöü\"",
    "expected_hex": "22c3a4c3b6c3bc22"
  },
  {
    "name": "non-bmp",
    "description": "Non-BMP character",
    "input": "😊",
    "expected_string": "\"😊\"",
    "expected_hex": "22f09f988a22"
  },
  {
    "name": "utf16-key-ordering-stress",
    "description": "UTF-16 key ordering stress case",
    "input": { "𐀀": 1, "嶲": 2, "a": 3, "é": 4 },
    "expected_string": "{\"a\":3,\"é\":4,\"𐀀\":1,\"嶲\":2}",
    "expected_hex": "7b2261223a332c22c3a9223a342c22f0908080223a312c22f0afa7b4223a327d"
  },
  {
    "name": "ascii-key-ordering",
    "description": "ASCII key ordering with punctuation, digits, case",
    "input": { "Z": 1, "a": 2, "1": 3, "!": 4, "z": 5 },
    "expected_string": "{\"!\":4,\"1\":3,\"Z\":1,\"a\":2,\"z\":5}",
    "expected_hex": "7b2221223a342c2231223a332c225a223a312c2261223a322c227a223a357d"
  },
  {
    "name": "safe-integer-min-max",
    "description": "Safe integer boundaries",
    "input": { "max": 9007199254740991, "min": -9007199254740991 },
    "expected_string": "{\"max\":9007199254740991,\"min\":-9007199254740991}",
    "expected_hex": "7b226d6178223a393030373139393235343734303939312c226d696e223a2d393030373139393235343734303939317d"
  },
  {
    "name": "deep-nesting",
    "description": "Moderately deep object nesting",
    "input": { "a": { "b": { "c": { "d": 1 } } } },
    "expected_string": "{\"a\":{\"b\":{\"c\":{\"d\":1}}}}",
    "expected_hex": "7b2261223a7b2262223a7b2263223a7b2264223a317d7d7d7d"
  }
]
