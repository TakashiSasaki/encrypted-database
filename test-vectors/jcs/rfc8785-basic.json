[
  {
    "name": "empty-object",
    "description": "Empty object",
    "input": {},
    "expected_string": "{}",
    "expected_hex": "7b7d"
  },
  {
    "name": "empty-array",
    "description": "Empty array",
    "input": [],
    "expected_string": "[]",
    "expected_hex": "5b5d"
  },
  {
    "name": "object-key-ordering",
    "description": "Object key ordering",
    "input": {
      "b": 2,
      "a": 1,
      "c": 3
    },
    "expected_string": "{\"a\":1,\"b\":2,\"c\":3}",
    "expected_hex": "7b2261223a312c2262223a322c2263223a337d"
  },
  {
    "name": "nested-objects",
    "description": "Nested objects and arrays",
    "input": {
      "b": {
        "d": 4,
        "c": 3
      },
      "a": 1
    },
    "expected_string": "{\"a\":1,\"b\":{\"c\":3,\"d\":4}}",
    "expected_hex": "7b2261223a312c2262223a7b2263223a332c2264223a347d7d"
  },
  {
    "name": "strings",
    "description": "Basic string",
    "input": {
      "string": "hello world"
    },
    "expected_string": "{\"string\":\"hello world\"}",
    "expected_hex": "7b22737472696e67223a2268656c6c6f20776f726c64227d"
  },
  {
    "name": "unicode-strings",
    "description": "Unicode strings",
    "input": {
      "unicode": "こんにちは世界"
    },
    "expected_string": "{\"unicode\":\"こんにちは世界\"}",
    "expected_hex": "7b22756e69636f6465223a22e38193e38293e381abe381a1e381afe4b896e7958c227d"
  },
  {
    "name": "escaping",
    "description": "String escaping",
    "input": {
      "escape": "\"\\\b\f\n\r\t"
    },
    "expected_string": "{\"escape\":\"\\\"\\\\\\b\\f\\n\\r\\t\"}",
    "expected_hex": "7b22657363617065223a225c225c5c5c625c665c6e5c725c74227d"
  },
  {
    "name": "integers",
    "description": "Integer values",
    "input": {
      "int": 42,
      "zero": 0,
      "neg": -100
    },
    "expected_string": "{\"int\":42,\"neg\":-100,\"zero\":0}",
    "expected_hex": "7b22696e74223a34322c226e6567223a2d3130302c227a65726f223a307d"
  },
  {
    "name": "arrays",
    "description": "Arrays",
    "input": [
      3,
      1,
      {
        "b": 2,
        "a": 1
      }
    ],
    "expected_string": "[3,1,{\"a\":1,\"b\":2}]",
    "expected_hex": "5b332c312c7b2261223a312c2262223a327d5d"
  },
  {
    "name": "booleans-and-null",
    "description": "Boolean and null values inside an object, testing sorting of new types",
    "input": {
      "true_val": true,
      "null_val": null,
      "false_val": false
    },
    "expected_string": "{\"false_val\":false,\"null_val\":null,\"true_val\":true}",
    "expected_hex": "7b2266616c73655f76616c223a66616c73652c226e756c6c5f76616c223a6e756c6c2c22747275655f76616c223a747275657d"
  },
  {
    "name": "nested-arrays",
    "description": "Arrays nested inside arrays and objects",
    "input": {
      "list": [
        1,
        [
          2,
          3,
          null
        ],
        false
      ],
      "empty": [
        []
      ]
    },
    "expected_string": "{\"empty\":[[]],\"list\":[1,[2,3,null],false]}",
    "expected_hex": "7b22656d707479223a5b5b5d5d2c226c697374223a5b312c5b322c332c6e756c6c5d2c66616c73655d7d"
  },
  {
    "name": "unicode-preservation-symbols",
    "description": "Preservation of unicode symbols without normalization",
    "input": {
      "symbols": "☃★☺"
    },
    "expected_string": "{\"symbols\":\"☃★☺\"}",
    "expected_hex": "7b2273796d626f6c73223a22e29883e29885e298ba227d"
  },
  {
    "name": "object-key-ordering-ascii",
    "description": "Object key ordering with various ASCII characters",
    "input": {
      "Z": 2,
      "a": 3,
      "A": 1,
      "z": 4
    },
    "expected_string": "{\"A\":1,\"Z\":2,\"a\":3,\"z\":4}",
    "expected_hex": "7b2241223a312c225a223a322c2261223a332c227a223a347d"
  }
]
